<Window x:Class="LinearActuator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linear Actuator Controller" Height="650" Width="980"
        MinHeight="560" MinWidth="860">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Linear Actuator Controller" FontSize="22" FontWeight="SemiBold" />

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="12" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="API" />
                <TextBlock Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center" Text="http://127.0.0.1:7500" />
                <Button x:Name="StartStopButton" Grid.Column="2" Width="110" Click="StartStopButton_Click" Content="Start" />
            </Grid>
        </Border>

        <DataGrid x:Name="ModuleGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" IsReadOnly="False" ItemsSource="{Binding ModuleRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ModuleId}" Header="Module" IsReadOnly="True" Width="70" />
                <DataGridCheckBoxColumn Binding="{Binding SerialEnabled, UpdateSourceTrigger=PropertyChanged}" Header="Serial On" Width="80" />
                <DataGridTextColumn Binding="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}" Header="COM Port" Width="110" />
                <DataGridTextColumn Binding="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Header="Baud" Width="90" />
                <DataGridTextColumn Binding="{Binding Status}" Header="Status" IsReadOnly="True" Width="160" />
                <DataGridTextColumn Binding="{Binding Current}" Header="Current A1 / A2 / A3 / A4" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Binding="{Binding Target}" Header="Target A1 / A2 / A3 / A4" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,16,0,0" Text="Loading..." TextWrapping="Wrap" />
    </Grid>
</Window>
