<Window x:Class="LinearActuator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linear Actuator Controller" Height="700" Width="1450"
        MinHeight="560" MinWidth="1080">
    <Window.Resources>
        <Style x:Key="ModuleLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModuleValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SmallInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Linear Actuator Controller" FontSize="22" FontWeight="SemiBold" />

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="12" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="API" />
                <TextBlock Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center" Text="http://127.0.0.1:7500" />
                <Button x:Name="StartStopButton" Grid.Column="2" Width="110" Click="StartStopButton_Click" Content="Start" />
                <Button Grid.Column="4" Width="110" Click="GetCurrentButton_Click" Content="Get Current" />
                <Button Grid.Column="6" Width="110" Click="SendTargetsButton_Click" Content="Send Targets" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Detected Ports">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" Margin="0,0,0,8" Height="28" Click="RefreshPortsButton_Click" Content="Refresh Ports" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PortRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="6" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding SerialEnabled, UpdateSourceTrigger=PropertyChanged}" Checked="PortToggle_Changed" Unchecked="PortToggle_Changed" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ComPort}" FontWeight="SemiBold" />
                                            <ToggleButton Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center" ToolTip="Lock mapped module" IsChecked="{Binding IsLocked, UpdateSourceTrigger=PropertyChanged}" Checked="PortLock_Changed" Unchecked="PortLock_Changed">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </ToggleButton>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding MappedModuleId}" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Margin="0,4,0,0" VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#444444" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Foreground" Value="Red" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Margin="0,4,0,0" Text="{Binding BinaryId}" FontSize="10" Foreground="#222222" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <Border Grid.Column="2" Padding="10" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4" Background="#F4F6F8">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ModuleGrid" ItemsSource="{Binding ModuleRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" Padding="8" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ModuleId}" FontSize="18" FontWeight="Bold" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Status}" Foreground="#444444" />
                                        </DockPanel>

                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="Mapped Port" />
                                                <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding MappedComPort}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="Baud" />
                                                <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding BaudRate}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#E2E5E9" BorderThickness="0,1,0,0" />

                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Margin="0,0,4,4" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C1 / T1" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C1T1}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Margin="4,0,0,4" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C2 / T2" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C2T2}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="1" Margin="0,4,4,0" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C3 / T3" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C3T3}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C4 / T4" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C4T4}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GroupBox Grid.Column="4" Header="Module Layout Reference">
                <Border Padding="8" Background="#FAFAFA" ClipToBounds="True">
                    <Grid>
                        <Image Source="res/ModuleGrid.png" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,16,0,0" Text="Loading..." TextWrapping="Wrap" />
    </Grid>
</Window>
