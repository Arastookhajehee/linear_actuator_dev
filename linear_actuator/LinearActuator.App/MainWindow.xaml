<Window x:Class="LinearActuator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linear Actuator Controller" Height="520" Width="760"
        MinHeight="480" MinWidth="680">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Linear Actuator Controller" FontSize="22" FontWeight="SemiBold" />

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="12" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="COM Port" />
                <TextBox x:Name="ComPortTextBox" Grid.Column="1" Margin="8,0,16,0" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="API Port" />
                <TextBox x:Name="ApiPortTextBox" Grid.Column="3" Margin="8,0,16,0" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Baud" />
                <TextBox x:Name="BaudRateTextBox" Grid.Column="5" Margin="8,0,16,0" />
                <Button x:Name="StartStopButton" Grid.Column="7" Width="110" Click="StartStopButton_Click" Content="Start" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Current Position" Margin="0,0,8,0">
                <UniformGrid Columns="2" Margin="12">
                    <TextBlock Text="A1" />
                    <TextBlock x:Name="A1CurrentTextBlock" Text="-" />
                    <TextBlock Text="A2" />
                    <TextBlock x:Name="A2CurrentTextBlock" Text="-" />
                    <TextBlock Text="A3" />
                    <TextBlock x:Name="A3CurrentTextBlock" Text="-" />
                    <TextBlock Text="A4" />
                    <TextBlock x:Name="A4CurrentTextBlock" Text="-" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Target" Margin="8,0,0,0">
                <UniformGrid Columns="2" Margin="12">
                    <TextBlock Text="A1" />
                    <TextBlock x:Name="A1TargetTextBlock" Text="-" />
                    <TextBlock Text="A2" />
                    <TextBlock x:Name="A2TargetTextBlock" Text="-" />
                    <TextBlock Text="A3" />
                    <TextBlock x:Name="A3TargetTextBlock" Text="-" />
                    <TextBlock Text="A4" />
                    <TextBlock x:Name="A4TargetTextBlock" Text="-" />
                </UniformGrid>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,16,0,0" Text="Loading..." TextWrapping="Wrap" />
    </Grid>
</Window>
