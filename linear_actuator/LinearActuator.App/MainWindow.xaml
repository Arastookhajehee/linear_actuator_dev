<Window x:Class="LinearActuator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linear Actuator Controller" Height="700" Width="1280"
        MinHeight="560" MinWidth="1080">
    <Window.Resources>
        <Style x:Key="ModuleLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModuleValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SmallInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Linear Actuator Controller" FontSize="22" FontWeight="SemiBold" />

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="12" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="API" />
                <TextBlock Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center" Text="http://127.0.0.1:7500" />
                <Button x:Name="StartStopButton" Grid.Column="2" Width="110" Click="StartStopButton_Click" Content="Start" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="10" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4" Background="#F4F6F8">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ModuleGrid" ItemsSource="{Binding ModuleRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" Padding="8" Background="White" BorderBrush="#C8CED6" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel>
                                             <TextBlock DockPanel.Dock="Left" Text="{Binding ModuleId}" FontSize="18" FontWeight="Bold" />
                                             <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Content="On" IsChecked="{Binding SerialEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="SerialToggle_Changed" Unchecked="SerialToggle_Changed" />
                                         </DockPanel>

                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="COM Port" />
                                                <TextBox Style="{StaticResource SmallInputStyle}" Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="Baud" />
                                                <TextBox Style="{StaticResource SmallInputStyle}" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#E2E5E9" BorderThickness="0,1,0,0" />

                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Margin="0,0,4,4" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C1 / T1" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C1T1}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Margin="4,0,0,4" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C2 / T2" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C2T2}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="1" Margin="0,4,4,0" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C3 / T3" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C3T3}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Padding="6" Background="#EEF5FF" CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ModuleLabelStyle}" Text="C4 / T4" />
                                                    <TextBlock Style="{StaticResource ModuleValueStyle}" Text="{Binding C4T4}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="4" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Status}" Foreground="#444444" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding BinaryId}" Foreground="#222222" FontWeight="SemiBold" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GroupBox Grid.Column="2" Header="Module Layout Reference">
                <Border Padding="8" Background="#FAFAFA" ClipToBounds="True">
                    <Grid>
                        <Image Source="res/ModuleGrid.png" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,16,0,0" Text="Loading..." TextWrapping="Wrap" />
    </Grid>
</Window>
