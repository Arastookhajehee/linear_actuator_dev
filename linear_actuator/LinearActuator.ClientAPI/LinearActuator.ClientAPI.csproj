<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LinearActuator.Core\LinearActuator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="NSwag.MSBuild" Version="14.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated\LinearActuatorApiClient.cs" Condition="!Exists('Generated\LinearActuatorApiClient.cs')" />
  </ItemGroup>

  <Target Name="GenerateClient">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="$(NSwagExe_Net80) run nswag.json" />
  </Target>

</Project>
